# Copiar a `.env.production` en el VPS (junto a docker-compose.yml) y
# completar con valores reales. NO subir `.env.production` a git.
#
# Solo el backend (apps/api) vive en este VPS — el Web sigue en Vercel, sin
# cambios. `docker compose --env-file .env.production up -d --build` usa
# este archivo tanto para las variables `${...}` del propio
# docker-compose.yml (Postgres) como, vía `env_file:`, para las variables en
# tiempo de ejecución del contenedor `api`.

# ─── Postgres (contenedor) ───────────────────────────────────────────────────
POSTGRES_USER=piel360
POSTGRES_PASSWORD=
POSTGRES_DB=piel360

# ─── apps/api ────────────────────────────────────────────────────────────────
# Host "postgres"/"redis" = nombre del servicio en docker-compose.yml, no localhost.
DATABASE_URL=postgresql://piel360:CHANGE_ME@postgres:5432/piel360?schema=public
REDIS_URL=redis://redis:6379
PORT=3000
# La URL REAL de Vercel donde vive el Web (no un dominio del VPS) — el
# backend usa esto para la whitelist de CORS (ver apps/api/src/main.ts).
FRONTEND_URL=https://tu-app.vercel.app

JWT_SECRET=
JWT_REFRESH_SECRET=

ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.tudominio.com/api/auth/google/callback
GOOGLE_MAPS_API_KEY=

YOUCAM_API_URL=
YOUCAM_API_KEY=
YOUCAM_WEBHOOK_SECRET=

SKINIVER_API_URL=
SKINIVER_API_TOKEN=

S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

RESEND_API_KEY=
MAIL_FROM=

ALTIRIA_API_KEY=
ALTIRIA_API_SECRET=
ALTIRIA_API_BASE_URL=https://www.altiria.net:8443/apirest/ws

# reCAPTCHA (login web y móvil) con CreateAssessment. El JSON de la cuenta de
# servicio se monta en el contenedor (docker-compose.override.yml) en
# /app/apps/api/.secrets/recaptcha-sa.json. RECAPTCHA_SITE_KEY = la clave web
# (la misma que NEXT_PUBLIC_RECAPTCHA_SITE_KEY en Vercel).
RECAPTCHA_MODE=enterprise
RECAPTCHA_SITE_KEY=
RECAPTCHA_PROJECT_ID=
RECAPTCHA_SERVICE_ACCOUNT_PATH=.secrets/recaptcha-sa.json
# La clave web es de casilla («No soy un robot»): no se exige puntuación.
RECAPTCHA_MIN_SCORE=0
RECAPTCHA_ENABLED=false
