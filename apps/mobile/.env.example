# URL base de la API Nest (incluye el prefijo /api).
#
# Se embebe en el bundle en build time. Tras cambiarla:
#   1) guarda .env
#   2) limpia y recompila release con EXPO_NO_METRO_LAZY=1
#
# Dev local:
#   EXPO_PUBLIC_API_URL=http://localhost:3000/api
# Prod:
#   EXPO_PUBLIC_API_URL=https://api.piel360.com/api
#
# Google OAuth: el Client Secret NO va aquí — solo en apps/api/.env
EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# reCAPTCHA Enterprise Mobile SDK (sin casilla).
# Keys de plataforma en Google Cloud → Create key → Android / iOS
# Package/bundle: com.piel360.app
# No funciona en Expo Go: hace falta expo run:android / run:ios.
# API: RECAPTCHA_MODE=enterprise + RECAPTCHA_ANDROID_SITE_KEY / IOS
EXPO_PUBLIC_RECAPTCHA_ENABLED=false
EXPO_PUBLIC_RECAPTCHA_ANDROID_SITE_KEY=
EXPO_PUBLIC_RECAPTCHA_IOS_SITE_KEY=

# Pruebas: omitir pantalla "Verifica tu celular" tras login. No usar en producción.
# EXPO_PUBLIC_SKIP_PHONE_VERIFICATION=true
