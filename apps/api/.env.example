# Copiar a .env para desarrollo. En Railway se configuran como variables del servicio
# (DATABASE_URL/REDIS_URL las inyectan automáticamente los plugins de Postgres/Redis).
#
# Requeridas al boot (la API no arranca sin ellas — usan config.getOrThrow):
#   DATABASE_URL, REDIS_URL, JWT_SECRET, JWT_REFRESH_SECRET, FRONTEND_URL,
#   ENCRYPTION_KEY, SKINIVER_API_URL, SKINIVER_API_TOKEN,
#   S3_BUCKET, S3_REGION, S3_ACCESS_KEY, S3_SECRET_KEY, YOUCAM_API_URL, YOUCAM_API_KEY
# Opcionales (tienen fallback si faltan):
#   RESEND_API_KEY, MAIL_FROM, GOOGLE_CLIENT_ID/SECRET/REDIRECT_URI,
#   S3_ENDPOINT, YOUCAM_WEBHOOK_SECRET, ALTIRIA_API_KEY, ALTIRIA_API_SECRET
#   (sin estas dos últimas, el OTP de teléfono queda en modo dev: no envía SMS
#   real y acepta cualquier código — ver SmsService)
#
# Las credenciales de Wompi NO van acá — se parametrizan en producción vía el
# CRUD de /admin/gateway-configs (tabla gateway_configs), no como env var.

DATABASE_URL=
REDIS_URL=
PORT=
FRONTEND_URL=

JWT_SECRET=
JWT_REFRESH_SECRET=

ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con "Authorized redirect URIs" en Google Cloud Console
# (es la URL de la API, no la del front). Ejemplos:
#   http://localhost:3000/api/auth/google/callback
#   https://api.piel360.com/api/auth/google/callback
# Tras el OAuth, la API redirige al front: ${FRONTEND_URL}/auth/google/callback
GOOGLE_REDIRECT_URI=
GOOGLE_MAPS_API_KEY=
# Deep link post-OAuth en la app móvil (scheme de app.json).
MOBILE_DEEP_LINK=piel360://auth/google/callback

YOUCAM_API_URL=
YOUCAM_API_KEY=
# Webhook registrado en el dashboard de Perfect Corp: https://<tu-dominio>/webhooks/youcam
YOUCAM_WEBHOOK_SECRET=

SKINIVER_API_URL=
SKINIVER_API_TOKEN=

S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
# local = disco en apps/api/storage (útil si S3 no resuelve en tu red).
# Si omites esto y S3 falla por DNS, el upload también cae a disco local.
STORAGE_DRIVER=
# URL pública de la API para armar links de archivos locales (móvil/emulador).
# Ej. http://10.0.2.2:3000  |  http://192.168.x.x:3000
PUBLIC_API_URL=
# En VPS con Nginx/CloudPanel delante de la API, sube el límite de body para
# documentos de registro (cédula, diploma, registro médico — hasta 10 MB c/u):
#   client_max_body_size 32m;

RESEND_API_KEY=
MAIL_FROM=

# OTP de teléfono (registro) — endpoints otp/generate y otp/check.
# Confirmar con Altiria/el dashboard cuál host aplica a esta cuenta antes de
# dar por bueno el default (ver comentario en sms.service.ts).
ALTIRIA_API_KEY=
ALTIRIA_API_SECRET=
ALTIRIA_API_BASE_URL=https://www.altiria.net:8443/apirest/ws
