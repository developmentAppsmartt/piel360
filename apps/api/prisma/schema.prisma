// Piel360 API — schema Prisma
// Diseño y mapeo completo de tablas: ver MIGRACION.md §7.1 en la raíz del Laravel actual (Piel360/).
//
// Prisma 7: el datasource ya NO acepta `url` (ver prisma.config.ts para el CLI/migrate;
// en runtime, PrismaService construye el cliente con un driver adapter — ver
// src/prisma/prisma.service.ts).
//
// Nota: el diseño original (MIGRACION.md) usaba `@db.LongText`, un tipo nativo de MySQL.
// Como el motor elegido es PostgreSQL (ver MIGRACION.md §7.4), se usa `@db.Text` en su lugar
// (en Postgres, TEXT ya no tiene límite de longitud).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 BigInt    @id @default(autoincrement())
  name               String
  email              String    @unique
  googleId           String?   @map("google_id")
  diagnosticLanguage String    @default("es") @map("diagnostic_language")
  emailVerifiedAt    DateTime? @map("email_verified_at")
  password           String
  firstName          String    @map("first_name")
  lastName           String    @map("last_name")
  birthday           DateTime? @db.Date
  gender             String?
  phone              String?
  phoneVerifiedAt    DateTime? @map("phone_verified_at")
  address            String?
  latitude           Decimal?  @db.Decimal(10, 7)
  longitude          Decimal?  @db.Decimal(10, 7)
  /** Key S3 de la foto de perfil (URL firmada al leer). */
  avatarKey          String?   @map("avatar_key")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  doctor                 Doctor?
  patient                Patient?
  moderator              Moderator?
  analyses               Analysis[]     @relation("ExecutedAnalyses")
  confirmedAnalyses      Analysis[]     @relation("ConfirmedAnalyses")
  subscriptions          Subscription[]
  roles                  Role[]
  sentMessages           Message[]
  ownedOrganizations     Organization[]       @relation("OrganizationOwner")
  organizationMembers    OrganizationMember[]
  referredBy             Referral[]           @relation("ReferredUser")
  platformUnitRecharges  PlatformUnitRecharge[]

  @@map("users")
}

/** Perfil de moderador (rol RBAC `monitor`) — validación de doctores. */
model Moderator {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @unique @map("user_id")
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  docType    String?  @map("doc_type")
  docNumber  String?  @map("doc_number")
  phone      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("moderators")
}

model Doctor {
  id                   BigInt    @id @default(autoincrement())
  userId               BigInt    @unique @map("user_id")
  firstName            String    @map("first_name")
  lastName             String    @map("last_name")
  birthDate            DateTime? @map("birth_date") @db.Date
  gender               String?
  docType              String?   @map("doc_type")
  docNumber            String?   @map("doc_number")
  phone                String?
  lat                  Decimal?  @db.Decimal(10, 8)
  lng                  Decimal?  @db.Decimal(11, 8)
  address              String?
  city                 String?
  department           String?
  country              String?
  zip                  String?
  metadataGooglePlaces Json?     @map("metadata_google_places")
  /** consultorio | spa | clinica | empresa_aliada | laboratorio */
  locationType              String?   @map("location_type")
  /** pending | in_review | verified */
  addressVerificationStatus String    @default("pending") @map("address_verification_status")
  addressVerifiedAt         DateTime? @map("address_verified_at")
  /** visit | google_maps | photo_evidence */
  addressVerificationMethod String?   @map("address_verification_method")
  addressVerificationEvidenceKey String? @map("address_verification_evidence_key")
  /** solo_doctor | empresa | empresa_aliada — intención de registro */
  membershipType       String    @default("solo_doctor") @map("membership_type")
  /** pending | in_review | verified | approved | active | rejected */
  verificationStatus   String    @default("pending") @map("verification_status")
  /** Observación del moderador al solicitar ajustes / rechazar. */
  verificationNote     String?   @map("verification_note") @db.Text
  verificationNoteAt   DateTime? @map("verification_note_at")
  /** Activa módulo Equipo (no es un rol RBAC). */
  empresa              Boolean   @default(false)
  /** Activa módulo Referidos (no es un rol RBAC). */
  empresaReferida      Boolean   @default(false) @map("empresa_referida")
  specialty            String?
  medicalRegistry      String?   @map("medical_registry")
  licenseNumber        String?   @map("license_number")
  educationEntity      String?   @map("education_entity")
  graduationInstitution String?  @map("graduation_institution")
  cedulaDocKey         String?   @map("cedula_doc_key")
  medicalRegistryDocKey String?  @map("medical_registry_doc_key")
  diplomaDocKey        String?   @map("diploma_doc_key")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  patients            Patient[]
  analysisRequests    AnalysisRequest[]
  conversations       Conversation[]
  productCategories   ProductCategory[]
  products            Product[]
  routines            Routine[]
  treatmentCategories TreatmentCategory[]
  treatments          Treatment[]

  @@map("doctors")
}

/** Organización / membresía empresa (planes de asientos, no créditos de análisis). */
model Organization {
  id           BigInt   @id @default(autoincrement())
  /** empresa | empresa_aliada */
  type         String
  name         String
  ownerUserId  BigInt   @map("owner_user_id")
  /** two | five | ten | custom */
  seatPlan     String   @default("two") @map("seat_plan")
  seatLimit    Int      @default(2) @map("seat_limit")
  referralCode String?  @unique @map("referral_code")
  /** pending | active | suspended */
  status       String   @default("pending")

  /** Perfil comercial (solo membresía empresa / empresa aliada). */
  ciiuCode           String?  @map("ciiu_code")
  address            String?
  city               String?  /** municipio */
  department         String?
  country            String?
  zip                String?
  lat                Decimal? @db.Decimal(10, 8)
  lng                Decimal? @db.Decimal(11, 8)
  businessEmail      String?  @map("business_email")
  businessPhone      String?  @map("business_phone")
  website            String?
  /** approx employee count bucket, e.g. "1-10" | "11-50" | … */
  employeeCountRange String?  @map("employee_count_range")
  legalRepName       String?  @map("legal_rep_name")
  legalRepDocType    String?  @map("legal_rep_doc_type")
  legalRepDocNumber  String?  @map("legal_rep_doc_number")
  legalRepCedulaDocKey String? @map("legal_rep_cedula_doc_key")
  rutDocKey          String?  @map("rut_doc_key")
  existenceCertDocKey String? @map("existence_cert_doc_key")

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  owner   User                 @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members OrganizationMember[]
  referrals Referral[]

  @@index([ownerUserId])
  @@map("organizations")
}

model OrganizationMember {
  id             BigInt   @id @default(autoincrement())
  organizationId BigInt   @map("organization_id")
  userId         BigInt   @map("user_id")
  /** owner | member */
  memberRole     String   @default("member") @map("member_role")
  /** Permisos del equipo: string[] (TEAM_MEMBER_PERMISSIONS). Owner ignora este campo. */
  permissions    Json     @default("[]")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

/** Stub de referidos para empresa aliada. */
model Referral {
  id             BigInt   @id @default(autoincrement())
  organizationId BigInt   @map("organization_id")
  code           String
  referredUserId BigInt?  @map("referred_user_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referredUser User?        @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([code])
  @@map("referrals")
}

model Patient {
  id                BigInt    @id @default(autoincrement())
  doctorId          BigInt?   @map("doctor_id")
  userId            BigInt?   @unique @map("user_id")
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  birthDate         DateTime? @map("birth_date") @db.Date
  gender            String?
  email             String?
  phone             String?
  areaCode          String?   @map("area_code")
  docType           String?   @map("doc_type")
  docNumber         String?   @map("doc_number")
  address           String?
  mascotType        String?   @map("mascot_type")
  skinType          String?   @map("skin_type")
  fitzpatrickType   String?   @map("fitzpatrick_type")
  lat               Decimal?  @db.Decimal(10, 8)
  lng               Decimal?  @db.Decimal(11, 8)
  regions           Json?
  surveyCompletedAt DateTime? @map("survey_completed_at")
  surveyResponses   Json?     @map("survey_responses")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  doctor        Doctor?        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses      Analysis[]
  conversations Conversation[]
  analysisRequests AnalysisRequest[]

  @@map("patients")
}

/** Solicitud de análisis del doctor al paciente (desbloquea «Nuevo Análisis» en mobile). */
model AnalysisRequest {
  id           BigInt   @id @default(autoincrement())
  patientId    BigInt   @map("patient_id")
  doctorId     BigInt   @map("doctor_id")
  /** skiniver | youcam | fitzpatrick */
  providerSlug String   @map("provider_slug")
  /** pending | completed | cancelled */
  status       String   @default("pending")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([patientId, status])
  @@index([doctorId])
  @@map("analysis_requests")
}

model Analysis {
  id              BigInt    @id @default(autoincrement())
  youcamTaskId      String? @map("youcam_task_id")
  fitzpatrickTaskId String? @map("fitzpatrick_task_id")
  patientId       BigInt    @map("patient_id")
  userId          BigInt?   @map("user_id")
  providerId      BigInt?   @map("provider_id")
  imagePath       String    @map("image_path")
  coloredS3Url    String?   @map("colored_s3_url")
  maskedS3Url     String?   @map("masked_s3_url")
  bodyRegion      String?   @map("body_region")
  xCoord          Float?    @map("x_coord")
  yCoord          Float?    @map("y_coord")
  zCoord          Float?    @map("z_coord")
  isValid         Boolean   @default(false) @map("is_valid")
  validationScore Float?    @map("validation_score")
  aiDiagnosis     String?   @map("ai_diagnosis")
  aiProbability   Float?    @map("ai_probability")
  aiRawResponse   Json?     @map("ai_raw_response")
  finalDiagnosis  String?   @map("final_diagnosis")
  isConfirmed       Boolean   @default(false) @map("is_confirmed")
  isCorrected       Boolean   @default(false) @map("is_corrected")
  doctorNotes       String?   @map("doctor_notes") @db.Text
  confirmedById     BigInt?   @map("confirmed_by")
  confirmedAt       DateTime? @map("confirmed_at")
  /** Visible para el paciente vinculado (Patient.userId) en su home/historial. */
  sharedWithPatient Boolean   @default(false) @map("shared_with_patient")
  sharedAt          DateTime? @map("shared_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  patient     Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user        User?              @relation("ExecutedAnalyses", fields: [userId], references: [id], onDelete: Cascade)
  confirmedBy User?              @relation("ConfirmedAnalyses", fields: [confirmedById], references: [id])
  provider    AnalysisProvider?  @relation(fields: [providerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "analyses_provider_fk")
  results     AnalysisResult[]
  usage       SubscriptionUsage?

  @@index([youcamTaskId])
  @@index([fitzpatrickTaskId])
  @@index([patientId], map: "idx_analyses_patient_id")
  @@index([userId], map: "idx_analyses_user_id")
  @@index([youcamTaskId], map: "idx_analyses_youcam_task_id")
  @@index([sharedWithPatient], map: "idx_analyses_shared_with_patient")
  @@map("analyses")
}

model AnalysisProvider {
  id        BigInt   @id @default(autoincrement())
  name      String
  slug      String   @unique
  /** Nombre para mostrar en UI (ej. "Análisis Dermatológico") — distinto de
   * `name` (la marca real, "Skiniver"/"YouCam", usada en planes/suscripciones). */
  displayLabel String? @map("display_label")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  analyses Analysis[]
  results  AnalysisResult[]
  plans    Plan[]

  @@map("analysis_providers")
}

model AnalysisResult {
  id         BigInt   @id @default(autoincrement())
  analysisId BigInt   @map("analysis_id")
  providerId BigInt?  @map("provider_id")
  type       String
  region     String?
  uiScore    Float?   @map("ui_score")
  rawScore   Float?   @map("raw_score")
  score      Float?
  /** Solo `hd_skin_type` — valor categórico ("oily", "dry"...), en minúsculas. */
  skinType   String?  @map("skin_type")
  createdAt  DateTime @default(now()) @map("created_at")

  analysis Analysis          @relation(fields: [analysisId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_analysis_results_analysis")
  provider AnalysisProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_analysis_results_provider")
  masks    AnalysisMask[]

  @@index([analysisId], map: "idx_analysis_results_analysis_id")
  @@index([providerId], map: "idx_analysis_results_provider_id")
  @@index([type], map: "idx_analysis_results_type")
  @@index([region], map: "idx_analysis_results_region")
  @@map("analysis_results")
}

model AnalysisMask {
  id               BigInt   @id @default(autoincrement())
  analysisResultId BigInt   @map("analysis_result_id")
  objectKey        String?  @map("object_key")
  url              String?
  createdAt        DateTime @default(now()) @map("created_at")

  result AnalysisResult @relation(fields: [analysisResultId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_analysis_masks_result")

  @@map("analysis_masks")
}

model Plan {
  id                   BigInt   @id @default(autoincrement())
  analysisProviderId   BigInt   @default(1) @map("analysis_provider_id")
  /** IDs de proveedores incluidos en el paquete (string[] en JSON). */
  analysisProviderIds  Json     @default("[]") @map("analysis_provider_ids")
  name                 String
  /** individual | business */
  planType           String   @default("business") @map("plan_type")
  analysisLimit      Int      @default(0) @map("analysis_limit")
  price              Decimal  @default(0) @db.Decimal(10, 2)
  durationDays       Int      @default(30) @map("duration_days")
  maxUsers           Int      @default(1) @map("max_users")
  modules            Json     @default("[]")
  roleLimits         Json     @default("{}") @map("role_limits")
  isActive           Boolean  @default(true) @map("is_active")
  description        String?  @db.Text
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  provider      AnalysisProvider @relation(fields: [analysisProviderId], references: [id])
  subscriptions Subscription[]

  @@map("plans")
}

enum SubscriptionStatus {
  pending
  active
  cancelled
}

model Subscription {
  id                 BigInt             @id @default(autoincrement())
  userId             BigInt             @map("user_id")
  planId             BigInt             @map("plan_id")
  wompiTransactionId String?            @map("wompi_transaction_id")
  status             SubscriptionStatus
  endsAt             DateTime?          @map("ends_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan   Plan                @relation(fields: [planId], references: [id], onDelete: Cascade)
  usages SubscriptionUsage[]
  poolAllocation SubscriptionPoolAllocation?

  @@index([wompiTransactionId])
  @@map("subscriptions")
}

model SubscriptionUsage {
  id             BigInt   @id @default(autoincrement())
  subscriptionId BigInt   @map("subscription_id")
  analysisId     BigInt   @unique @map("analysis_id")
  quantity       Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  analysis     Analysis     @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@map("subscription_usages")
}

/** Créditos reservados de la bolsa global al activar una suscripción. */
model SubscriptionPoolAllocation {
  id             BigInt   @id @default(autoincrement())
  subscriptionId BigInt   @unique @map("subscription_id")
  /** skiniver | perfectcorp */
  poolProvider   String   @map("pool_provider")
  allocated      Int
  returned       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([poolProvider])
  @@map("subscription_pool_allocations")
}

model EncyclopediaEntry {
  id          BigInt   @id @default(autoincrement())
  url         String   @unique
  originalUrl String?  @map("original_url")
  title       String?
  content     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("encyclopedia_entries")
}

model GatewayConfig {
  id              BigInt   @id @default(autoincrement())
  gatewayName     String   @default("wompi") @map("gateway_name")
  environment     String   @default("sandbox")
  publicKey       String   @map("public_key") @db.Text
  privateKey      String?  @map("private_key") @db.Text // cifrado en app (ver EncryptionService)
  integritySecret String?  @map("integrity_secret") @db.Text // cifrado en app
  webhookSecret   String?  @map("webhook_secret") @db.Text // cifrado en app
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("gateway_configs")
}

model PasswordResetToken {
  id        BigInt   @id @default(autoincrement())
  email     String
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("password_reset_tokens")
}

/**
 * Hilo 1:1 doctor ↔ paciente. Soft-delete y archivo por participante.
 */
model Conversation {
  id                BigInt    @id @default(autoincrement())
  doctorId          BigInt    @map("doctor_id")
  patientId         BigInt    @map("patient_id")
  doctorArchivedAt  DateTime? @map("doctor_archived_at")
  patientArchivedAt DateTime? @map("patient_archived_at")
  doctorDeletedAt   DateTime? @map("doctor_deleted_at")
  patientDeletedAt  DateTime? @map("patient_deleted_at")
  doctorLastReadAt  DateTime? @map("doctor_last_read_at")
  patientLastReadAt DateTime? @map("patient_last_read_at")
  lastMessageAt     DateTime? @map("last_message_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  doctor   Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient  Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([doctorId, patientId])
  @@index([doctorId, lastMessageAt])
  @@index([patientId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             BigInt    @id @default(autoincrement())
  conversationId BigInt    @map("conversation_id")
  senderUserId   BigInt    @map("sender_user_id")
  /**
   * text | image | video | pdf
   */
  type           String    @default("text")
  body           String?   @db.Text
  attachmentKey  String?   @map("attachment_key")
  attachmentName String?   @map("attachment_name")
  mimeType       String?   @map("mime_type")
  sizeBytes      Int?      @map("size_bytes")
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Role {
  id                       BigInt                @id @default(autoincrement())
  name                     String                @unique
  label                    String?
  description              String?               @db.Text
  color                    String?               @default("#6C4FFB")
  isActive                 Boolean               @default(true) @map("is_active")
  /** Panel principal al que aplica este rol: admin | clinical | patient */
  primaryPanel             String?               @default("clinical") @map("primary_panel")
  permissions              Permission[]
  users                    User[]
  specialty                DoctorSpecialty?
  laborTechnicianProfileId BigInt?               @unique @map("labor_technician_profile_id")
  laborTechnicianProfile   LaborTechnicianProfile? @relation(fields: [laborTechnicianProfileId], references: [id], onDelete: SetNull)
  specialtyLinks           RoleSpecialtyLink[]

  @@map("roles")
}

/** Especialidad médica del registro de doctor — cada una tiene un rol RBAC asociado. */
model DoctorSpecialty {
  id          BigInt   @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  roleId    BigInt   @unique @map("role_id")
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  roleLinks RoleSpecialtyLink[]

  @@map("doctor_specialties")
}

/** Perfil de técnico laboral (cosmetología, estética, etc.) — carrera técnica por competencias. */
model LaborTechnicianProfile {
  id          BigInt   @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  role        Role?

  @@map("labor_technician_profiles")
}

model RoleSpecialtyLink {
  roleId            BigInt          @map("role_id")
  doctorSpecialtyId BigInt          @map("doctor_specialty_id")
  role              Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  doctorSpecialty   DoctorSpecialty @relation(fields: [doctorSpecialtyId], references: [id], onDelete: Cascade)

  @@id([roleId, doctorSpecialtyId])
  @@map("role_specialty_links")
}

model Permission {
  id          BigInt   @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  label       String?
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  kind        String   @default("action")
  panel       String?
  href        String?
  sortOrder   Int      @default(0) @map("sort_order")
  parentSlug  String?  @map("parent_slug")
  roles       Role[]

  @@index([panel, kind, isActive])
  @@map("permissions")
}

/** Configuración global de la aplicación (clave-valor). */
model AppConfig {
  id        BigInt   @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_configs")
}

/** Categorías de productos — scoped al doctor. */
model ProductCategory {
  id           BigInt   @id @default(autoincrement())
  doctorId     BigInt   @map("doctor_id")
  categoryName String   @map("category_name")
  createdAt    DateTime @default(now()) @map("created_at")
  lastModified DateTime @updatedAt @map("last_modified")

  doctor   Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([doctorId])
  @@map("product_categories")
}

/** Productos — scoped al doctor vía categoría. */
model Product {
  id                 BigInt   @id @default(autoincrement())
  doctorId           BigInt   @map("doctor_id")
  categoryId         BigInt   @map("category_id")
  productName        String   @map("product_name")
  productDescription String?  @map("product_description") @db.Text
  productUrl         String?  @map("product_url")
  imageUrl           String?  @map("image_url")
  /** "product" | "supplement" — mismo CRUD/UI, solo cambia etiqueta y filtro. */
  productType        String   @default("product") @map("product_type")
  enablePrice        Boolean  @default(false) @map("enable_price")
  /** "fixed" | "variable" */
  pricingType        String?  @map("pricing_type")
  currencyCode       String   @default("COP") @map("currency_code")
  originalPrice      Decimal? @map("original_price") @db.Decimal(12, 2)
  sellingPrice       Decimal? @map("selling_price") @db.Decimal(12, 2)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  doctor         Doctor             @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  category       ProductCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  routineSteps   RoutineStep[]
  treatmentItems TreatmentProduct[]

  @@index([doctorId])
  @@index([categoryId])
  @@index([productType])
  @@map("products")
}

model Routine {
  id          BigInt   @id @default(autoincrement())
  doctorId    BigInt   @map("doctor_id")
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  doctor     Doctor             @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  conditions RoutineCondition[]
  steps      RoutineStep[]

  @@index([doctorId])
  @@map("routines")
}

/** Condiciones de una rutina — combinadas con lógica O (basta con que una se
 * cumpla) contra AnalysisResult.{uiScore ?? score ?? rawScore} del mismo
 * metricType+region. Solo aplica a análisis YouCam por ahora. */
model RoutineCondition {
  id         BigInt   @id @default(autoincrement())
  routineId  BigInt   @map("routine_id")
  /** Uno de YOUCAM_DST_ACTIONS (packages/shared/src/constants.ts), ej. "hd_wrinkle". */
  metricType String   @map("metric_type")
  /** null = sin región / "whole". */
  region     String?
  /** "lt" | "lte" | "eq" | "gte" | "gt" — validado en el DTO. */
  operator   String
  /** Numérica — null cuando la condición es categórica (ver textValue). */
  value      Float?
  /** Categórica — solo `hd_skin_type` (uno de YOUCAM_SKIN_TYPE_VALUES). Una
   * condición usa `value` O `textValue`, nunca ambos. */
  textValue  String?  @map("text_value")
  createdAt  DateTime @default(now()) @map("created_at")

  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@index([routineId])
  @@map("routine_conditions")
}

model RoutineStep {
  id          BigInt   @id @default(autoincrement())
  routineId   BigInt   @map("routine_id")
  order       Int
  title       String
  /** Texto libre — incluye horario/frecuencia (ej. "Aplicar cada noche antes de dormir"). */
  description String?  @db.Text
  /** Key S3 cruda (no URL) — mismo patrón que Product.imageUrl, se firma al leer. */
  mediaUrl    String?  @map("media_url")
  /** "image" | "video" | "gif". */
  mediaType   String?  @map("media_type")
  productId   BigInt?  @map("product_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  routine Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([routineId])
  @@index([productId])
  @@map("routine_steps")
}

/** Categorías de tratamiento — scoped al doctor, texto libre (ej. "Invasivo",
 * "No invasivo"). Mismo patrón que ProductCategory. */
model TreatmentCategory {
  id           BigInt   @id @default(autoincrement())
  doctorId     BigInt   @map("doctor_id")
  categoryName String   @map("category_name")
  createdAt    DateTime @default(now()) @map("created_at")
  lastModified DateTime @updatedAt @map("last_modified")

  doctor     Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  treatments Treatment[]

  @@index([doctorId])
  @@map("treatment_categories")
}

/** Entidad unificada: lista ordenada de productos recomendados, condicionada
 * por puntaje. Si categoryId es null se presenta al doctor como "Producto
 * sugerido"; con categoría, como "Tratamiento" — mismo backend en ambos casos. */
model Treatment {
  id          BigInt   @id @default(autoincrement())
  doctorId    BigInt   @map("doctor_id")
  categoryId  BigInt?  @map("category_id")
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  doctor     Doctor               @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  category   TreatmentCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  conditions TreatmentCondition[]
  items      TreatmentProduct[]

  @@index([doctorId])
  @@index([categoryId])
  @@map("treatments")
}

/** Condiciones de un tratamiento — mismo shape/motor que RoutineCondition. */
model TreatmentCondition {
  id          BigInt   @id @default(autoincrement())
  treatmentId BigInt   @map("treatment_id")
  metricType  String   @map("metric_type")
  region      String?
  operator    String
  /** Numérica — null cuando la condición es categórica (ver textValue). */
  value       Float?
  /** Categórica — solo `hd_skin_type` (uno de YOUCAM_SKIN_TYPE_VALUES). Una
   * condición usa `value` O `textValue`, nunca ambos. */
  textValue   String?  @map("text_value")
  createdAt   DateTime @default(now()) @map("created_at")

  treatment Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  @@index([treatmentId])
  @@map("treatment_conditions")
}

/** Ítem ordenado dentro de un Treatment — lista plana de productos, sin pasos
 * ni media (a diferencia de RoutineStep). onDelete: Cascade en product porque
 * una fila sin su producto no tiene sentido (a diferencia de RoutineStep). */
model TreatmentProduct {
  id          BigInt   @id @default(autoincrement())
  treatmentId BigInt   @map("treatment_id")
  productId   BigInt   @map("product_id")
  order       Int
  /** Nota/uso específico dentro de este tratamiento. */
  note        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  treatment Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([treatmentId])
  @@index([productId])
  @@map("treatment_products")
}

/** Recargas manuales de la bolsa global de unidades (p. ej. Skiniver). */
model PlatformUnitRecharge {
  id          BigInt    @id @default(autoincrement())
  provider    String
  quantity    Int
  expiresAt   DateTime? @map("expires_at")
  note        String?   @db.Text
  createdById BigInt?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([provider, createdAt])
  @@map("platform_unit_recharges")
}
